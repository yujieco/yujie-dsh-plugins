{
  "name": "yujie-dsh-plugin-sider-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 插件：在会话右侧边栏实时列出正在监听的端口，点击即可在浏览器打开。Right-sidebar panel listing the session ports with one-click browser open.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ports",
    "dev-server",
    "sidebar",
    "vite",
    "react"
  ],
  "homepage": "https://github.com/yujieco/yujie-dsh-plugin-sider-motion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yujieco/yujie-dsh-plugin-sider-motion.git"
  },
  "bugs": {
    "url": "https://github.com/yujieco/yujie-dsh-plugin-sider-motion/issues"
  },
  "author": "yujieco"
}
